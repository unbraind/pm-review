{"hash_algorithm":"sha256","ts":"2026-10-28T15:21:39.183Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"b72b4ad539c4794f7abb86ea","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.312","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-review-kucs"},{"op":"add","path":"/metadata/title","value":"Daily release never publishes: npm reads release-artifact/package.tgz as a GitHub repository"},{"op":"add","path":"/metadata/description","value":"The release job runs npm publish release-artifact/package.tgz. npm parses a bare dir/file.tgz spec as the GitHub shorthand owner/repo and runs git ls-remote ssh://git@github.com/release-artifact/package.tgz.git, which fails with Permission denied (publickey); after 3 attempts the job reports that nothing was published. Latest release run: https://github.com/unbraind/pm-review/actions/runs/40667460413 (failure). Fix: publish ./release-artifact/package.tgz so npm reads the verified local archive."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":0},{"op":"add","path":"/metadata/tags","value":["ci","npm","release"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-28T15:21:39.183Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-28T15:21:39.183Z"},{"op":"add","path":"/metadata/author","value":"claude-hub"},{"op":"add","path":"/metadata/acceptance_criteria","value":"release.yml publishes ./release-artifact/package.tgz; no other npm or bun command passes a bare relative tarball path; the next daily release publishes to npm with provenance"},{"op":"add","path":"/metadata/severity","value":"high"}],"before_hash